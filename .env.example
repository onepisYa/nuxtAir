# ========================================
# NuxtAir 环境变量配置示例
# ========================================
# 使用说明：
# 1. 复制此文件为 .env 并填入实际值
# 2. 根据不同环境（开发/生产）调整相应配置
# 3. 请勿将包含敏感信息的 .env 文件提交到版本控制

# ----------------------------------------
# 端口配置
# ----------------------------------------

# 开发服务器端口
# Nuxt 开发服务器监听端口，默认 3000，如果被占用会自动递增
# 常用端口：3000, 3001, 4000
NUXT_DEV_PORT=3000

# 开发服务器主机
# 开发服务器绑定的主机地址
# localhost: 仅本机访问
# 0.0.0.0: 允许局域网访问
NUXT_DEV_HOST=0.0.0.0

# 局域网访问地址
# 用于生成局域网访问的 baseUrl，方便同事访问
# 例如：192.168.1.100 或您的实际局域网 IP
# 如果不设置，开发环境将使用 localhost
# NUXT_DEV_NETWORK_HOST=192.168.1.100

# 生产服务器端口
# 生产环境通过 PORT 环境变量控制（由部署平台或 PM2 设置）
# 开发环境也可以通过此变量指定端口，默认 4000
# 部署示例: PORT=8000 node .output/server/index.mjs
# PORT=4000

# ----------------------------------------
# 网站基础配置
# ----------------------------------------

# 网站完整域名（包含协议）
# 用于 SEO、sitemap 和 robots.txt 生成
# 开发环境会根据实际端口动态生成
# 生产环境示例：https://www.yoursite.com
NUXT_PUBLIC_BASE_URL=https://www.yoursite.com

# 网站名称
# 显示在浏览器标题、SEO 元数据等位置
NUXT_PUBLIC_SITENAME=NuxtAir

# ----------------------------------------
# API 服务配置
# ----------------------------------------

# 后端 API 服务器地址
# 开发环境示例：http://localhost:3001
# 生产环境示例：https://api.your-domain.com
NUXT_API_BASE_URL=https://api.your-domain.com

# 公开 API 路径前缀
# 前端请求 API 时使用的路径前缀
# 开发环境建议：/dev-api
# 生产环境建议：/api 或 /prod-api
NUXT_PUBLIC_API_BASE=/api

# 测试 API 路径前缀（可选）
# 用于测试环境的 API 请求
# NUXT_PUBLIC_TEST_API_BASE=/test-api

# ----------------------------------------
# 图片服务配置
# ----------------------------------------

# 图片服务主机名
# 用于图片资源的 CDN 或静态文件服务器
# 开发环境：http://localhost
# 生产环境建议：https://cdn.your-domain.com
NUXT_IMG_HOSTNAME=images.your-domain.com

# ----------------------------------------
# 联系信息配置
# ----------------------------------------

# 网站联系电话
# 显示在联系页面和相关组件中
NUXT_PUBLIC_PHONENUMBER=+86-123-4567-8890

# ----------------------------------------
# 环境特定配置
# ----------------------------------------

# 运行环境（通常由部署系统自动设置）
# development | production | test
# NODE_ENV=development

# Nuxt 开发工具（仅开发环境）
# 启用 Nuxt DevTools 调试面板
# NUXT_DEVTOOLS=true

# Nitro 预设（生产环境）
# 部署平台预设配置
# 可选值：node-server, vercel, netlify, cloudflare-pages 等
# NITRO_PRESET=node-server

# ----------------------------------------
# 功能控制配置
# ----------------------------------------

# 测试页面排除控制
# 设置为 'true' 可在开发环境中排除 /pages/test/ 目录下的页面
# 生产环境 (NODE_ENV=production) 会自动排除测试页面
# 开发时建议设置为 false，以便访问测试页面
EXCLUDE_TEST_PAGES=false

# ----------------------------------------
# SEO 和站点地图配置
# ----------------------------------------
# 重要提示：
# 1. NUXT_PUBLIC_BASE_URL 必须是完整的域名，包含协议（https://）
# 2. 这些配置会被 nuxt.config.ts 中的 site 配置使用
# 3. 正确配置对于生成 sitemap、robots.txt 和 hreflang 标签至关重要
# 4. 生产环境部署前请仔细检查所有 URL 配置

# ----------------------------------------
# 安全注意事项
# ----------------------------------------
# 1. 请勿在此文件中存储 API 密钥、数据库密码等敏感信息
# 2. 敏感信息应通过服务器环境变量或密钥管理服务配置
# 3. 生产环境的 .env 文件不应提交到版本控制系统
# 4. 定期检查和更新环境变量配置