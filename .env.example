# Nuxt SEO 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 网站基础配置
NUXT_PUBLIC_BASE_URL=https://your-domain.com
NUXT_PUBLIC_SITENAME=NuxtAir

# API 配置
NUXT_PUBLIC_API_BASE=/api
NUXT_API_BASE_URL=https://api.your-domain.com

# 图片服务配置
NUXT_IMG_HOSTNAME=images.your-domain.com

# 联系信息
NUXT_PUBLIC_PHONENUMBER=+86-123-4567-8890

# 开发环境配置（可选）
# NODE_ENV=development
# NUXT_DEVTOOLS=true

# 生产环境配置（可选）
# NODE_ENV=production
# NITRO_PRESET=node-server

# SEO 相关配置
# 这些变量会被 nuxt.config.ts 中的 site 配置使用
# 确保 NUXT_PUBLIC_BASE_URL 是完整的域名，包含协议（https://）
# 这对于生成正确的 sitemap、robots.txt 和 hreflang 标签至关重要