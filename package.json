{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxi dev --dotenv .env --host",
    "generate": "nuxi generate --dotenv .env.production && node zip.js",
    "build": "nuxi build",
    "build:prod": "nuxi build --dotenv .env.production",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare",
    "serve": "serve .output/public",
    "up": "npx taze major -I",
    "typecheck": "nuxi typecheck",
    "nuxi": "nuxi",
    "seo:validate": "node scripts/seo-validator.js",
    "seo:check": "npm run seo:validate",
    "seo:test": "npm run build && npm run seo:validate"
  },
  "dependencies": {
    "@nuxt/icon": "1.13.0",
    "@nuxt/ui": "3.1.3",
    "@pinia/nuxt": "^0.11.1",
    "@unhead/vue": "^2.0.10",
    "@vueuse/nuxt": "13.3.0",
    "alova": "^3.3.3",
    "dayjs": "^1.11.13",
    "dayjs-nuxt": "^2.1.11",
    "he": "^1.2.0",
    "lodash.findkey": "^4.6.0",
    "nuxt": "^3.17.5",
    "nuxt-schema-org": "^5.0.6",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.3.0",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@alova/wormhole": "^1.0.6",
    "@antfu/eslint-config": "^4.14.1",
    "@css-inline/css-inline": "^0.16.0",
    "@css-inline/css-inline-wasm": "^0.16.0",
    "@iconify-json/ep": "^1.2.2",
    "@iconify-json/ic": "^1.2.2",
    "@iconify-json/lucide": "^1.2.47",
    "@nuxt/eslint": "1.4.1",
    "@nuxtjs/i18n": "10.0.1",
    "@nuxtjs/seo": "^3.1.0",
    "@types/he": "^1.2.3",
    "archiver": "^7.0.1",
    "eslint": "^9.29.0",
    "eslint-plugin-format": " ^1.0.1",
    "eslint-plugin-vue": "^10.2.0",
    "nuxi": "^3.26.4",
    "sass-embedded": "^1.89.2",
    "strip": "^3.0.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vite-plugin-eslint2": "^5.0.3",
    "vue-tsc": "^3.0.3"
  }
}
