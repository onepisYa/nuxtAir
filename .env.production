# ========================================
# NuxtAir 生产环境配置文件
# ========================================
# 此文件包含生产环境的环境变量配置
# 部署时会自动加载此文件中的配置

# ----------------------------------------
# API 服务配置
# ----------------------------------------

# API 基础 URL - 生产环境后端服务地址
# 生产环境请配置为实际的后端 API 服务器地址
# NUXT_API_BASE_URL=https://api.yourdomain.com
# NUXT_API_BASE_URL=http://127.0.0.1  # 本地测试用

# 公开 API 路径前缀
# 生产环境的 API 请求路径前缀
NUXT_PUBLIC_API_BASE=/prod-api

# ----------------------------------------
# 图片服务配置
# ----------------------------------------

# 图片服务主机名
# 生产环境建议使用 CDN 或专用的静态资源服务器
# 例如：https://cdn.yourdomain.com
NUXT_IMG_HOSTNAME=https://cdn.yourdomain.com

# ----------------------------------------
# 网站基础信息
# ----------------------------------------

# 网站基础 URL
# 生产环境的完整域名地址，用于 SEO、sitemap 和绝对链接生成
# 请替换为实际的生产域名
NUXT_PUBLIC_BASE_URL=https://www.yourdomain.com

# 网站名称
# 生产环境的正式网站名称
NUXT_PUBLIC_SITENAME=网站名称 onepisya prod--

# 联系电话
# 生产环境的官方联系电话
NUXT_PUBLIC_PHONENUMBER=1234567

# ----------------------------------------
# 生产环境说明
# ----------------------------------------
# 注意事项：
# 1. 生产环境会自动排除 /pages/test/ 目录下的测试页面
# 2. 请确保所有敏感信息（如 API 密钥）通过服务器环境变量配置
# 3. 图片服务建议使用 CDN 以提高加载速度
# 4. API 地址应指向生产环境的后端服务
