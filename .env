# ========================================
# NuxtAir 开发环境配置文件
# ========================================
# 此文件包含开发环境的环境变量配置
# 请勿将此文件提交到版本控制系统

# ----------------------------------------
# API 服务配置
# ----------------------------------------

# API 基础 URL - 后端服务地址
# 开发环境使用 JSONPlaceholder 作为测试 API
# 生产环境请替换为实际的后端服务地址
# NUXT_API_BASE_URL=http://127.0.0.1  # 本地开发服务器
NUXT_API_BASE_URL=https://jsonplaceholder.typicode.com

# 公开 API 路径前缀
# 用于前端 API 请求的路径前缀，会暴露给客户端
NUXT_PUBLIC_API_BASE=/dev-api

# 测试 API 路径前缀
# 用于测试环境的 API 请求路径
NUXT_PUBLIC_TEST_API_BASE=/test-api

# ----------------------------------------
# 图片服务配置
# ----------------------------------------

# 图片服务主机名
# 用于图片资源的 CDN 或静态资源服务器地址
NUXT_IMG_HOSTNAME=http://localhost

# ----------------------------------------
# 网站基础信息
# ----------------------------------------

# 网站基础 URL
# 用于生成绝对链接、SEO 和 sitemap
# 开发环境使用本地地址，生产环境请替换为实际域名
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# 网站名称
# 显示在浏览器标题栏和 SEO 元数据中
NUXT_PUBLIC_SITENAME=网站名称 onepisya--

# 联系电话
# 显示在网站联系信息中
NUXT_PUBLIC_PHONENUMBER=1234567

# ----------------------------------------
# 开发工具配置
# ----------------------------------------

# 测试页面排除控制
# 设置为 true 时，开发环境也会排除 /pages/test/ 目录下的页面
# 生产环境会自动排除测试页面，无需此配置
EXCLUDE_TEST_PAGES=true