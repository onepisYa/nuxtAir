# ========================================
# NuxtAir 开发环境配置文件
# ========================================
# 此文件包含开发环境的环境变量配置
# 请勿将此文件提交到版本控制系统

# ----------------------------------------
# API 服务配置
# ----------------------------------------

# API 基础 URL - 后端服务地址
# 开发环境使用 JSONPlaceholder 作为测试 API
# 生产环境请替换为实际的后端服务地址
# NUXT_API_BASE_URL=http://127.0.0.1  # 本地开发服务器
NUXT_API_BASE_URL=https://jsonplaceholder.typicode.com

# 公开 API 路径前缀
# 用于前端 API 请求的路径前缀，会暴露给客户端
NUXT_PUBLIC_API_BASE=/dev-api

# 测试 API 路径前缀
# 用于测试环境的 API 请求路径
NUXT_PUBLIC_TEST_API_BASE=/test-api

# ----------------------------------------
# 图片服务配置
# ----------------------------------------

# 图片服务主机名
# 用于图片资源的 CDN 或静态资源服务器地址
NUXT_IMG_HOSTNAME=http://localhost

# ----------------------------------------
# 网站基础信息
# ----------------------------------------

# ----------------------------------------
# 端口配置
# ----------------------------------------

# 开发服务器端口
# Nuxt 开发服务器监听端口，默认 4000 build 生产的端口、如果生产端口也被占用那么会自动递增
NUXT_DEV_PORT=4000

# 开发服务器主机
# 开发服务器绑定的主机地址，0.0.0.0 允许外部访问
NUXT_DEV_HOST=0.0.0.0

# 局域网访问地址
# 用于生成局域网访问的 baseUrl，方便同事访问
# 例如：10.190.16.2 或您的实际局域网 IP
# 如果不设置，开发环境将使用 localhost
NUXT_DEV_NETWORK_HOST=127.0.0.1

# 生产服务器端口
# 生产环境通过 PORT 环境变量控制（由部署平台或 PM2 设置）
# 开发环境也可以通过 变量指定端口，默认 4000
# 部署运行示例: PORT=8000 node .output/server/index.mjs
# PORT=8000

# 网站基础 URL
# 用于生成绝对链接、SEO 和 sitemap
# 开发环境会根据实际端口动态生成，生产环境请替换为实际域名
NUXT_PUBLIC_BASE_URL=http://localhost

# 网站名称
# 显示在浏览器标题栏和 SEO 元数据中
NUXT_PUBLIC_SITENAME=网站名称 onepisya--

# 联系电话
# 显示在网站联系信息中
NUXT_PUBLIC_PHONENUMBER=1234567

# ----------------------------------------
# 开发工具配置
# ----------------------------------------

# 测试页面排除控制
# 设置为 true 时，开发环境也会排除 /pages/test/ 目录下的页面
# 生产环境会自动排除测试页面，无需此配置
EXCLUDE_TEST_PAGES=false